@model CookBooks.Models.Recipe

@{
    ViewBag.Title = "Редактировать рецепт — CookBooks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .form-container {
            max-width: 800px;
            margin: 50px auto;
            padding: 40px;
            background: linear-gradient(rgba(201,25,55,.05), rgba(245,209,153,.08));
            border-radius: 36px 10px;
        }

        .form-group {
            margin-bottom: 25px;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                margin-bottom: 8px;
                color: #333;
            }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #FDB646;
            border-radius: 10px 0;
            font-family: "Inter", sans-serif;
            font-size: 16px;
        }

            .form-control:focus {
                border-color: #C91937;
                outline: none;
            }

        textarea.form-control {
            resize: vertical;
            min-height: 100px;
        }

        .btn-submit {
            background: #C91937;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            border-radius: 15px 0;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-submit:hover {
                background: #a0142e;
                transform: translateY(-2px);
            }

        select.form-control {
            cursor: pointer;
        }
    </style>
}

<div class="container">
    <div class="form-container">
        <h2 style="color: #C91937; margin-bottom: 30px;">✏️ Редактировать рецепт</h2>
        
        <form method="post" action="/Recipes/Edit/@ViewBag.RecipeId">
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label>Название рецепта *</label>
                <input type="text" name="title" class="form-control" value="@Model.Title" required />
            </div>
            
            <div class="form-group">
                <label>Краткое описание *</label>
                <textarea name="description" class="form-control" rows="3" required>@Model.Description</textarea>
            </div>
            
            <div class="form-group">
                <label>Ингредиенты *</label>
                <textarea name="ingredients" class="form-control" rows="6" required>@Model.Ingredients</textarea>
                <small style="color: #666;">Каждый ингредиент с новой строки</small>
            </div>
            
            <div class="form-group">
                <label>Инструкция *</label>
                <textarea name="instructions" class="form-control" rows="8" required>@Model.Instructions</textarea>
                <small style="color: #666;">Каждый шаг с новой строки</small>
            </div>
            
            <div class="form-group">
                <label>Время приготовления (минуты)</label>
                <input type="number" name="cookingTime" class="form-control" value="@Model.CookingTime" />
            </div>
            
            <div class="form-group">
                <label>Сложность</label>
                <select name="difficulty" class="form-control">
                    <option value="0" @(Model.Difficulty == CookBooks.Models.DifficultyLevel.Easy ? "selected" : "")>Легко</option>
                    <option value="1" @(Model.Difficulty == CookBooks.Models.DifficultyLevel.Medium ? "selected" : "")>Средне</option>
                    <option value="2" @(Model.Difficulty == CookBooks.Models.DifficultyLevel.Hard ? "selected" : "")>Сложно</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>Категория</label>
                <input type="text" name="category" class="form-control" value="@Model.Category" />
            </div>
            
            <div class="form-group">
                <label>URL изображения</label>
                <input type="text" name="imageUrl" class="form-control" value="@Model.ImageUrl" />
                <small style="color: #666;">Оставьте пустым для использования изображения по умолчанию</small>
            </div>
            
            <div style="text-align: center;">
                <button type="submit" class="btn-submit">Сохранить изменения</button>
            </div>
        </form>
    </div>
</div>