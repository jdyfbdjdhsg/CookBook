@model List<CookBooks.Models.Recipe>

@{
    ViewBag.Title = "Мой профиль — CookBooks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/style.css" />
    <link rel="stylesheet" href="~/assets/recept.css" />
    <style>
        .profile-header {
            background: linear-gradient(135deg, #C91937, #FDB646);
            padding: 40px;
            border-radius: 36px 10px;
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

            .profile-header h1 {
                font-size: 36px;
                margin-bottom: 10px;
            }

            .profile-header p {
                font-size: 18px;
                opacity: 0.9;
            }

        .admin-badge {
            display: inline-block;
            background: gold;
            color: #C91937;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
            margin-left: 10px;
        }
    </style>
}

<div class="container__main">
    <div class="profile-header">
        <h1>
            @ViewBag.UserName
            @if (ViewBag.IsAdmin == true)
            {
                <span class="admin-badge">АДМИН</span>
            }
        </h1>
        <p>Ваши кулинарные шедевры</p>
    </div>

    <div style="display: flex; justify-content: flex-end; margin-bottom: 30px;">
        <a href="/Recipes/Create" class="btn reg__btn">➕ Добавить новый рецепт</a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 100px 0;">
            <p style="font-size: 18px; color: #666;">У вас пока нет рецептов</p>
            <a href="/Recipes/Create" class="btn reg__btn" style="margin-top: 20px; display: inline-block;">➕ Добавить первый рецепт</a>
        </div>
    }
    else
    {
        <div class="rec__items">
            @foreach (var recipe in Model)
            {
                <div class="rec__item">
                    <a href="/Recipes/Details/@recipe.Id" style="text-decoration: none; color: inherit;">
                        <img class="item__img" src="@(recipe.ImageUrl ?? "/assets/img/rec__item.png")" alt="@recipe.Title">
                        <div class="item__text">
                            <div>
                                <h3>@recipe.Title</h3>
                                <div class="item__time">
                                    <img src="~/assets/img/Clock.svg" alt="">
                                    <p>@recipe.CookingTime мин</p>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div style="padding: 10px; display: flex; gap: 10px; justify-content: center;">
                        <a href="/Recipes/Edit/@recipe.Id" class="btn ex__btn" style="padding: 5px 15px; font-size: 12px;">Редактировать</a>
                        <form action="/Recipes/Delete/@recipe.Id" method="post" onsubmit="return confirm('Удалить рецепт?');" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="background: #dc3545; border: none; border-radius: 15px 0; padding: 5px 15px; color: white; cursor: pointer;">Удалить</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>